<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ProofShiftProductVersion>0.1.0-preview.1</ProofShiftProductVersion>
    <ProofShiftSourceRevision Condition="'$(ProofShiftSourceRevision)' == ''">unknown</ProofShiftSourceRevision>
    <ProofShiftSourceTree Condition="'$(ProofShiftSourceTree)' == ''">unknown</ProofShiftSourceTree>
    <Version>$(ProofShiftProductVersion)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(ProofShiftProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and ('$(MSBuildProjectName)' == 'ProofShift.Connectors.Db2' or '$(MSBuildProjectName)' == 'ProofShift.Cli' or '$(MSBuildProjectName)' == 'ProofShift.Connectors.Db2.Tests' or '$(MSBuildProjectName)' == 'ProofShift.EndToEnd.Tests')">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.windows.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' and ('$(MSBuildProjectName)' == 'ProofShift.Connectors.Db2' or '$(MSBuildProjectName)' == 'ProofShift.Cli' or '$(MSBuildProjectName)' == 'ProofShift.Connectors.Db2.Tests' or '$(MSBuildProjectName)' == 'ProofShift.EndToEnd.Tests')">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.linux.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ProofShiftProductVersion" Value="$(ProofShiftProductVersion)" />
    <AssemblyMetadata Include="ProofShiftSourceRevision" Value="$(ProofShiftSourceRevision)" />
    <AssemblyMetadata Include="ProofShiftSourceTree" Value="$(ProofShiftSourceTree)" />
    <AssemblyMetadata Include="ProofShiftTargetFramework" Value="$(TargetFramework)" />
  </ItemGroup>
</Project>
